# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Secret. Server-only. Used for admin actions (e.g. creating users directly).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Local file storage for uploaded photos/documents/logos (Phase 1 - see README)
UPLOADS_DIR="./uploads"

# Resend (resend.com) - used to send team invite emails. Optional: without
# it, invites still work but no email is sent (only the copyable link).
RESEND_API_KEY="re_xxxxxxxx"
# Must be onboarding@resend.dev unless you've verified your own domain in Resend.
RESEND_FROM_EMAIL="BinaWorks <onboarding@resend.dev>"
