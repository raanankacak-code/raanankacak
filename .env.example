# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Secret. Server-only. Used for admin actions (e.g. creating users directly).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase project settings -> Database -> Connection string (URI, pooler mode is fine)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Local file storage for uploaded photos/documents/logos (Phase 1 - see README)
UPLOADS_DIR="./uploads"
