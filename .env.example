# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Secret. Server-only. Used for admin actions (e.g. creating users directly)
# and for reading/writing the private "uploads" storage bucket.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Uploaded photos/documents/logos live in a private Supabase Storage bucket
# named "uploads" - no extra config needed, but the bucket must exist. See
# the "File uploads" section of the README for how to create it.

# Number of reverse proxies in front of this app (nginx/Caddy = 1, CDN +
# load balancer = 2). Rate limiting reads the client IP this many entries in
# from the right of X-Forwarded-For, since callers can forge the left of it.
# Too high lets callers spoof their IP and bypass rate limits; too low puts
# everyone behind your proxy in one shared bucket.
TRUSTED_PROXY_HOPS="1"

# The public origin of this deployment. Set this in production. Invite links
# and Stripe return URLs are built from it, and without it they fall back to
# the request's Host header - which a proxy that doesn't pin Host lets a
# caller set, so a forged Host puts an attacker's domain in the "Accept
# invitation" button of an email that genuinely came from you. The app logs a
# warning on every such link when this is unset.
NEXT_PUBLIC_APP_URL="https://app.your-domain.com"


# Resend (resend.com) - used to send team invite emails. Optional: without
# it, invites still work but no email is sent - the Invite dialog says so and
# points at the copyable link on the invitation's row.
RESEND_API_KEY="re_xxxxxxxx"
# Must be onboarding@resend.dev unless you've verified your own domain in Resend.
RESEND_FROM_EMAIL="BinaWorks <onboarding@resend.dev>"
# Optional. Defaults to Resend's real endpoint. Point a staging deploy at a
# mail catcher (Mailpit, Mailhog) so test invites never reach real inboxes.
# RESEND_API_URL="http://localhost:1025/emails"

# Stripe (stripe.com) - billing. Optional: without STRIPE_SECRET_KEY, trials
# still work and the workspace still goes read-only on expiry, but the
# Billing page shows "contact support" instead of working checkout buttons.
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
# From the Stripe CLI (`stripe listen`) in dev, or the webhook endpoint's
# signing secret in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
# Price ids (Product catalog -> a price's "..." menu -> Copy price ID),
# one per plan in lib/billing/plans.ts. A plan with no price set here shows
# "Contact support to switch to this plan" instead of a checkout button.
STRIPE_PRICE_STARTER="price_xxxxxxxx"
STRIPE_PRICE_PROFESSIONAL="price_xxxxxxxx"
STRIPE_PRICE_BUSINESS="price_xxxxxxxx"
