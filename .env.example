# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Secret. Server-only. Used for admin actions (e.g. creating users directly)
# and for reading/writing the private "uploads" storage bucket.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Uploaded photos/documents/logos live in a private Supabase Storage bucket
# named "uploads" - no extra config needed, but the bucket must exist. See
# the "File uploads" section of the README for how to create it.

# Resend (resend.com) - used to send team invite emails. Optional: without
# it, invites still work but no email is sent (only the copyable link).
RESEND_API_KEY="re_xxxxxxxx"
# Must be onboarding@resend.dev unless you've verified your own domain in Resend.
RESEND_FROM_EMAIL="BinaWorks <onboarding@resend.dev>"

# Stripe (stripe.com) - billing. Optional: without STRIPE_SECRET_KEY, trials
# still work and the workspace still goes read-only on expiry, but the
# Billing page shows "contact support" instead of working checkout buttons.
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
# From the Stripe CLI (`stripe listen`) in dev, or the webhook endpoint's
# signing secret in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
# Price ids (Product catalog -> a price's "..." menu -> Copy price ID),
# one per plan in lib/billing/plans.ts. A plan with no price set here shows
# "Contact support to switch to this plan" instead of a checkout button.
STRIPE_PRICE_STARTER="price_xxxxxxxx"
STRIPE_PRICE_PROFESSIONAL="price_xxxxxxxx"
STRIPE_PRICE_BUSINESS="price_xxxxxxxx"
